# ==============================================================================
# Variables d'environnement - ShopLoc Users Service
# ==============================================================================
# Ce fichier sert de modèle pour la configuration locale.
# Pour l'utiliser, dupliquez-le sous le nom .env :
#   cp .env.example .env
#
# NOTE :
# - En local (Docker Compose), les variables ci-dessous permettent de surcharger
#   les valeurs par défaut (devuser / devpassword / app_db).
# - En production / cluster K3s, les secrets sont injectés directement
#   depuis les Secrets Kubernetes 'db-credentials-users' et 'jwt-secret'.
# ==============================================================================

# Port d'écoute du service Spring Boot
PORT=8080

# Hôte et port de la base de données PostgreSQL
# - Pour Docker Compose : DB_HOST=db
# - Pour une exécution directe hors Docker (IDE / mvn) : DB_HOST=localhost
DB_HOST=db
DB_PORT=5432

# Identifiants de la base de données PostgreSQL
POSTGRES_DB=app_db
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpassword

# Variables complémentaires utilisées directement par le backend Spring Boot
DB_NAME=app_db
DB_USER=devuser
DB_PASSWORD=devpassword

# ==============================================================================
# SÉCURITÉ JWT (Asymétrique RSA RS256 - Obligatoire)
# ==============================================================================
# Users-Service est l'autorité d'authentification centrale de ShopLoc :
# c'est le SEUL microservice habilité à détenir la clé privée et à émettre des jetons.

# 1. Clé privée RSA 2048-bit (PKCS#8 Base64) - Obligatoire pour signer les jetons émis
JWT_PRIVATE_KEY=

# 2. Clé publique RSA 2048-bit (X.509 SPKI Base64) - Exposée sur /.well-known/jwks.json et /v1/auth/public-key
JWT_PUBLIC_KEY=

# 3. Identifiant de la clé active pour rotation (défaut : shoploc-key-1)
JWT_KEY_ID=shoploc-key-1

# Comment générer une paire de clés RSA 2048 bits :
# - Avec OpenSSL (Linux / macOS / Git Bash) :
#     openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#     openssl pkcs8 -topk8 -inform PEM -outform PEM -in private.pem -out private_pkcs8.pem -nocrypt
#     openssl rsa -in private.pem -pubout -outform PEM -out public.pem
#     JWT_PRIVATE_KEY=$(grep -v '^-' private_pkcs8.pem | tr -d '\r\n')
#     JWT_PUBLIC_KEY=$(grep -v '^-' public.pem | tr -d '\r\n')
#
# - Sur Windows PowerShell :
# @"
# var kpg = java.security.KeyPairGenerator.getInstance("RSA");
# kpg.initialize(2048);
# var kp = kpg.generateKeyPair();
# System.out.println("JWT_PRIVATE_KEY=" + java.util.Base64.getEncoder().encodeToString(kp.getPrivate().getEncoded()));
# System.out.println("JWT_PUBLIC_KEY=" + java.util.Base64.getEncoder().encodeToString(kp.getPublic().getEncoded()));
# /exit
# "@ | jshell -s -
