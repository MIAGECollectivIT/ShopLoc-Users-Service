# ==============================================================================
# Environment Variables - ShopLoc Users Service
# ==============================================================================
# This file serves as a template for local configuration.
# To use it, copy it as .env:
#   cp .env.example .env
#
# NOTE:
# - In local development (Docker Compose), the variables below allow overriding
#   default values (devuser / devpassword / app_db).
# - In production / K3s cluster, secrets are injected directly
#   from Kubernetes Secrets 'db-credentials-users' and 'jwt-secret'.
# ==============================================================================

# Listening port for the Spring Boot service
PORT=8080

# PostgreSQL database host and port
# - For Docker Compose: DB_HOST=db
# - For direct execution outside Docker (IDE / mvn): DB_HOST=localhost
DB_HOST=db
DB_PORT=5432

# PostgreSQL database credentials
POSTGRES_DB=app_db
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpassword

# Additional variables used directly by the Spring Boot backend
DB_NAME=app_db
DB_USER=devuser
DB_PASSWORD=devpassword

# Enable public user registration (POST /v1/users) for local development (false in production)
REGISTRATION_ENABLED=true

# ==============================================================================
# JWT SECURITY (Asymmetric RSA RS256 - Required)
# ==============================================================================
# Users-Service is the central authentication authority for ShopLoc:
# it is the ONLY microservice authorized to hold the private key and issue tokens.

# 1. RSA 2048-bit private key (PKCS#8 Base64) - Required to sign issued tokens
JWT_PRIVATE_KEY=

# 2. RSA 2048-bit public key (X.509 SPKI Base64) - Exposed on /.well-known/jwks.json and /v1/auth/public-key
JWT_PUBLIC_KEY=

# 3. Active key identifier for rotation (default: shoploc-key-1)
JWT_KEY_ID=shoploc-key-1

# How to generate an RSA 2048-bit key pair:
# - With OpenSSL (Linux / macOS / Git Bash):
#     openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#     openssl pkcs8 -topk8 -inform PEM -outform PEM -in private.pem -out private_pkcs8.pem -nocrypt
#     openssl rsa -in private.pem -pubout -outform PEM -out public.pem
#     JWT_PRIVATE_KEY=$(grep -v '^-' private_pkcs8.pem | tr -d '\r\n')
#     JWT_PUBLIC_KEY=$(grep -v '^-' public.pem | tr -d '\r\n')
#
# - On Windows PowerShell:
# @"
# var kpg = java.security.KeyPairGenerator.getInstance("RSA");
# kpg.initialize(2048);
# var kp = kpg.generateKeyPair();
# System.out.println("JWT_PRIVATE_KEY=" + java.util.Base64.getEncoder().encodeToString(kp.getPrivate().getEncoded()));
# System.out.println("JWT_PUBLIC_KEY=" + java.util.Base64.getEncoder().encodeToString(kp.getPublic().getEncoded()));
# /exit
# "@ | jshell -s -
