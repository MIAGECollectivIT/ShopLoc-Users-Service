# ==============================================================================
# Variables d'environnement - ShopLoc Users Service
# ==============================================================================
# Ce fichier sert de modèle pour la configuration locale.
# Pour l'utiliser, dupliquez-le sous le nom .env :
#   cp .env.example .env
#
# NOTE :
# - En local (Docker Compose), les variables ci-dessous permettent de surcharger
#   les valeurs par défaut (devuser / devpassword / app_db).
# - En production / cluster K3s, les secrets sont injectés directement
#   depuis le Secret Kubernetes 'db-credentials-users'.
# ==============================================================================

# Port d'écoute du service Spring Boot
PORT=8080

# Hôte et port de la base de données PostgreSQL
# - Pour Docker Compose : DB_HOST=db
# - Pour une exécution directe hors Docker (IDE / mvn) : DB_HOST=localhost
DB_HOST=db
DB_PORT=5432

# Identifiants de la base de données PostgreSQL
# (Correspondent aux clés POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD du secret K3S db-credentials-users)
POSTGRES_DB=app_db
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpassword

# Variables complémentaires utilisées directement par le backend Spring Boot
DB_NAME=app_db
DB_USER=devuser
DB_PASSWORD=devpassword

# Clé secrète JWT pour la validation des tokens d'authentification
JWT_SECRET=dGhpc2lzYXZlcnlzZWNyZXRqd3R1c2Vyc3NlcnZpY2VrZXkxMjM0NTY=
